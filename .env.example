# Copy to .env.local for local testing. On Vercel set these in
# Project → Settings → Environment Variables (never commit real values).

# Telegram bot that posts booking requests (token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Administrators' group id, a negative number like -1001234567890
TELEGRAM_CHAT_ID=

# Optional: the site's public address once a domain is connected
# (otherwise settings.url in src/content/site.json, otherwise the *.vercel.app address)
NEXT_PUBLIC_SITE_URL=
